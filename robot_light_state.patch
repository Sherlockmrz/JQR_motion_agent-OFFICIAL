+    # ======================
+    # 机器状态灯相关接口
+    # ======================
+
+    def set_robot_light_state(self, state: Any) -> Dict[str, Any]:
+        """设置机器状态灯业务场景。
+
+        上层协议只暴露两种状态：1=working，2=idle。底层 MCU 的场景编号
+        与上层编号不同，因此必须在这里完成映射。
+        """
+        state_key = str(state).strip()
+        scene_map = {
+            "1": (2, "working"),  # StatusLightScene.WORKING
+            "2": (1, "idle"),     # StatusLightScene.WAITING
+        }
+
+        if state_key not in scene_map:
+            return {
+                "type": "set_robot_light_state",
+                "success": False,
+                "error_msg": "state参数无效，仅支持1(working)或2(idle)"
+            }
+
+        scene, state_name = scene_map[state_key]
+        logger.info(
+            f"[SET_ROBOT_LIGHT_STATE] 设置机器状态灯: "
+            f"state={state_key}({state_name}), scene={scene}"
+        )
+
+        result = self._call_ros2_service_async(
+            "/set_status_light_scene",
+            CallbackGroupType.REENTRANT,
+            "jqr_ros_msgs/srv/StatusLightScene",
+            {
+                "scene": scene,
+                "ambient": 0,          # DAY
+                "restart_pattern": True
+            },
+            timeout=5.0
+        )
+
+        if not result.get("success"):
+            error_msg = result.get("error_msg") or "未响应"
+            logger.error(f"[SET_ROBOT_LIGHT_STATE] {error_msg}")
+            return {
+                "type": "set_robot_light_state",
+                "success": False,
+                "error_msg": error_msg
+            }
+
+        response = result.get("response", {})
+        if response.get("accepted") is not True:
+            error_msg = response.get("message") or "MCU未接受灯光命令"
+            logger.error(f"[SET_ROBOT_LIGHT_STATE] {error_msg}")
+            return {
+                "type": "set_robot_light_state",
+                "success": False,
+                "error_msg": error_msg
+            }
+
+        logger.info(f"[SET_ROBOT_LIGHT_STATE] MCU已接受{state_name}灯光命令")
+        return {
+            "type": "set_robot_light_state",
+            "success": True,
+            "error_msg": ""
+        }
+
