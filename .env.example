# Agent Configuration - Environment Variables
# Copy this file to .env and modify as needed.

# Main LLM backend:
# local_ws = use the existing local websocket model service
# openai_compatible = use an online OpenAI-compatible API
LLM_BACKEND=local_ws

# Local model service
# LOCAL_MODEL_URI=ws://127.0.0.1:8001/ws/navigate

# OpenAI-compatible online model
# OPENAI_API_KEY=your_api_key
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=Qwen3-32B

# USB serial
# USB_SERIAL_PORT=/dev/ttyACM0
# USB_SERIAL_BAUDRATE=115200
# USB_SERIAL_ENABLED=false

# Separate MCU Base workspace installed from vendor/jqr_base bundle
# JQR_BASE_WS=/app/jqr_ws

# Data and file paths
# DB_PATH=history.db
# ASM_JSON_PATH=asm_data.json
# VIDEO_BASE_DIR=videos
# WELCOME_POSITION_FILE=/home/sunrise/welcome_position.txt

# WebSocket server
# WEBSOCKET_HOST=0.0.0.0
# WEBSOCKET_PORT=8766
